{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ts",
    "level",
    "service",
    "event",
    "attrs"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "level": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "service": {
      "enum": [
        "node",
        "worker"
      ]
    },
    "event": {
      "enum": [
        "service.started",
        "fetch.transcript",
        "sponsorblock.call",
        "node.enrolled",
        "node.revoked",
        "node.heartbeat",
        "job.enqueued",
        "job.claimed",
        "job.completed",
        "job.released",
        "job.lease_expired",
        "job.stale_result",
        "job.validation_failed",
        "auth.bearer.rejected",
        "auth.client.registered",
        "auth.oauth.completed",
        "auth.oauth.denied",
        "auth.token.issued",
        "auth.refresh.reuse_detected",
        "auth.origin.rejected",
        "mcp.tool.call",
        "worker.call"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "video_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "attrs": {
      "type": "object"
    }
  }
}
